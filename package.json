{
  "name": "@wandelbots/wandelbots-js-react-components",
  "version": "0.0.0-semantically-released",
  "description": "React UI toolkit for building applications on top of the Wandelbots platform",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "README.md"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./3d": {
      "types": "./dist/3d.d.ts",
      "import": "./dist/3d.js",
      "require": "./dist/3d.cjs"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "playground:preview": "vite preview --config playground/vite.config.ts",
    "dev:pack": "nodemon -V -w src -e '*' -x \"pnpm run build && pnpm pack\"",
    "dev:build": "nodemon -V -w src -e '*' -x \"vite build && tsc --declaration --emitDeclarationOnly\"",
    "dev:wbjs": "nodemon --watch $WBJS_PATH -e tgz --exec 'pnpm install file:$WBJS_PATH && pnpm run playground'",
    "tsc": "tsc --pretty --noEmit -p playground/tsconfig.json",
    "test:unit": "vitest --workspace vitest.workspace.ts --project unit",
    "test:unit:run": "vitest run --workspace vitest.workspace.ts --project unit",
    "test:consumer": "pnpm run build && vitest run --workspace vitest.workspace.ts --project consumer",
    "test:e2e": "vitest run --workspace vitest.workspace.ts --project e2e",
    "test:playground": "pnpm run playground:build && playwright test",
    "build": "rimraf dist && vite build && tsc --declaration --emitDeclarationOnly",
    "api:update": "pnpm run build && tsx scripts/api-extractor.ts --local",
    "api:check": "tsx scripts/api-extractor.ts",
    "api:check-breaking": "tsx scripts/check-breaking-api.ts",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format . --write",
    "prepare": "husky || true",
    "td": "tsx scripts/td-wrapper.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wandelbotsgmbh/wandelbots-js-react-components.git"
  },
  "keywords": [
    "ui",
    "toolkit",
    "wandelbots"
  ],
  "author": "Wandelbots",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@playwright/test": "^1.59.1",
    "@react-three/drei": "^10.2.0",
    "@react-three/fiber": "^9.1.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@wandelbots/fonts": "^1.2.0",
    "@wandelbots/mui": "^2.0.1",
    "dotenv": "^18.0.9",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "mobx": "^7.1.5",
    "mobx-react-lite": "^5.1.2",
    "nodemon": "^3.1.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.2",
    "three": "^0.187.0",
    "three-stdlib": "^2.35.14",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "username": "^7.0.0",
    "vite": "^8.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "@wandelbots/mui": "^2.0.0",
    "mobx": "^7.1.5",
    "mobx-react-lite": "^5.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.182",
    "three-stdlib": ">=2"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "three-stdlib": {
      "optional": true
    }
  },
  "dependencies": {
    "@wandelbots/design-tokens": "^3.5.0",
    "@wandelbots/icons": "^2.2.0",
    "@wandelbots/nova-js": "4.13.0",
    "axios": "^1.15.0",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash-es": "^4.17.21",
    "react-error-boundary": "^6.0.3",
    "react-i18next": "^16.5.2"
  }
}
